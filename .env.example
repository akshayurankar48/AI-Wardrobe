# Required by the Eve HTTP channel to verify Clerk-issued Convex session tokens.
CLERK_FRONTEND_API_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev

# Shared only between Eve's server runtime and the Convex /eve/ingest endpoint.
# Use the same random value in the Convex deployment and this app's .env.local.
EVE_SESSION_REGISTRATION_SECRET=<generate-a-random-secret>
